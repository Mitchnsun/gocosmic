# Server-side API key for Resend, used to email free mockup requests and
# contact form submissions.
# Never prefix it with NEXT_PUBLIC_ — it must stay out of the client bundle.
# Outside production, leaving it unset logs each contact form submission
# server-side and accepts it, and reports a send failure for the free mockup
# form, so both can be exercised locally without a provider. In production a
# missing key makes the contact form report a send failure instead of falsely
# confirming a message nobody would read — set it before deploying.
RESEND_API_KEY=

# Optional. Sender of every email the site sends (free mockup requests and
# contact form submissions). It must be an address on a domain verified in
# the Resend dashboard.
# Defaults to "Cosmic Studio <noreply@gocosmic.dev>" when left empty.
RESEND_FROM_EMAIL=

# Optional. Google Calendar appointment booking page shown in the "Book a call"
# tab of the contact page, e.g. https://calendar.google.com/calendar/appointments/schedules/...
# Only calendar.google.com URLs are accepted (the CSP frame-src allows nothing
# else). When empty, the tab invites visitors to write a message instead.
NEXT_PUBLIC_GCAL_BOOKING_URL=
