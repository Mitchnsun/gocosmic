# Server-side API key for Resend, used to email free mockup requests and
# contact form submissions.
# Never prefix it with NEXT_PUBLIC_ — it must stay out of the client bundle.
RESEND_API_KEY=

# Optional. Sender of the free mockup notification email. It must be an address
# on a domain verified in the Resend dashboard.
# Defaults to "Go Cosmic <noreply@gocosmic.dev>" when left empty.
RESEND_FROM_EMAIL=

# Contact form delivery (app/api/contact/route.ts).
# When these two variables are unset, submissions are accepted and logged
# server-side instead of being emailed — useful for local development.

# Inbox receiving the contact form submissions.
CONTACT_TO_EMAIL=
# Verified sender address used by the mail provider.
CONTACT_FROM_EMAIL=
